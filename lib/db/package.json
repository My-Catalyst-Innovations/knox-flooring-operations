{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./control": "./src/control.ts",
    "./workspace": "./src/workspace.ts"
  },
  "scripts": {
    "migrate": "node scripts/migrate.mjs",
    "migrate:check": "node scripts/migrate.mjs --check",
    "migration:generate": "drizzle-kit generate --dialect postgresql --schema ./src/schema/index.ts --out ./migrations",
    "reconcile": "node scripts/reconcile.mjs",
    "test": "node --test scripts/migration-runner.test.mjs scripts/customer-import-postgres.test.mjs scripts/legacy-history-schema.test.mjs scripts/legacy-history-postgres.test.mjs scripts/supplier-import-schema.test.mjs scripts/supplier-import-postgres.test.mjs scripts/open-po-import-schema.test.mjs scripts/open-po-import-postgres.test.mjs scripts/active-job-import-schema.test.mjs scripts/active-job-import-postgres.test.mjs scripts/vendor-bill-coverage-schema.test.mjs scripts/vendor-bill-coverage-postgres.test.mjs scripts/vendor-bill-coverage-concurrency-independent.test.mjs",
    "test:open-po-import": "node --test scripts/open-po-import-schema.test.mjs scripts/open-po-import-postgres.test.mjs",
    "test:legacy-history": "node --test scripts/legacy-history-schema.test.mjs scripts/legacy-history-postgres.test.mjs",
    "test:customer-import": "node --test scripts/customer-import-postgres.test.mjs",
    "test:release": "node --test scripts/release-workflows.test.mjs && node --test scripts/sms-preferences-workflow.test.mjs",
    "test:sms-preferences": "node --test scripts/sms-preferences-workflow.test.mjs",
    "rehearse:backup": "node scripts/rehearse-backup.mjs",
    "test:supplier-import": "node --test scripts/supplier-import-schema.test.mjs scripts/supplier-import-postgres.test.mjs",
    "test:active-job-import": "node --test scripts/active-job-import-schema.test.mjs scripts/active-job-import-postgres.test.mjs",
    "test:bill-coverage": "node --test scripts/vendor-bill-coverage-schema.test.mjs scripts/vendor-bill-coverage-postgres.test.mjs scripts/vendor-bill-coverage-concurrency-independent.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
