# Required application settings
PORT=8080
DATABASE_URL=postgresql://user:password@host:25060/database?sslmode=require
APP_BASE_URL=http://localhost:8080
DEMO_ACCESS_ENABLED=false
BACKGROUND_WORKERS_ENABLED=true

# First owner (only used when the users table is empty)
OWNER_EMAIL=owner@example.com
OWNER_INITIAL_PASSWORD=replace-with-at-least-12-characters
OWNER_NAME=Knox Flooring Owner

# Optional file storage using the App Service managed identity and a private Blob container.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=

# Executive demo and safe communications
DEMO_MODE=true
# Explicit seed command only; leave disabled for every existing workspace.
ALLOW_DEMO_SEED=false
# For isolated restore/test environments use BACKGROUND_WORKERS_ENABLED=false,
# DEMO_ACCESS_ENABLED=false, DEMO_MODE=true, and omit all integration credentials.
# Outbound email and SMS. DEMO_MODE always captures instead of sending.
# When DEMO_MODE=false, use capture, allowlist (default), or live.
COMMS_DELIVERY_MODE=allowlist
# Comma-separated email addresses or phone numbers used in allowlist mode.
COMMS_ALLOWLIST=

# AI Quote Copilot (deterministic fallback remains available without a key)
OPENAI_API_KEY=
OPENAI_ESTIMATOR_MODEL=gpt-5.6-terra
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Tutorial narration (ElevenLabs preferred; OpenAI above is the automatic fallback)
TUTORIAL_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Select or design a young male teaching voice in ElevenLabs and paste its voice ID here.
# When the ID is blank, the app looks up the young, friendly Liam tutorial voice.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=Liam - Energetic, Social Media Creator
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_VOICE_STABILITY=0.48
ELEVENLABS_VOICE_SIMILARITY=0.78
ELEVENLABS_VOICE_STYLE=0.32
ELEVENLABS_VOICE_SPEED=0.96

# Direct Resend email. Use an address on a verified sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Catalyst Works <service@example.com>
RESEND_REPLY_TO_EMAIL=
# Unique Resend signing secret for this workspace's email delivery webhook.
RESEND_WEBHOOK_SECRET=
# Requires DEMO_MODE=false, Resend configuration, and an HTTPS APP_BASE_URL.
PASSWORD_RESET_EMAIL_ENABLED=false

# Company SMS. SignalWire is preferred when configured. Set twilio to keep an existing sender.
COMMS_SMS_PROVIDER=
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SIGNING_KEY=
SIGNALWIRE_FROM_NUMBER=

# Existing Twilio SMS. Use either a registered E.164 sender or messaging service.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# QuickBooks Online / Intuit Developer app
QUICKBOOKS_ENVIRONMENT=sandbox
# Enable owner-approved live vendor bills only for the named QuickBooks company.
QUICKBOOKS_PRODUCTION_VENDOR_BILLS_ENABLED=false
QUICKBOOKS_PRODUCTION_VENDOR_BILLS_REALM_ID=
QUICKBOOKS_PRODUCTION_STOCK_ITEMS_ENABLED=false
QUICKBOOKS_PRODUCTION_STOCK_ITEMS_REALM_ID=
QUICKBOOKS_PRODUCTION_INVENTORY_ADJUSTMENTS_ENABLED=false
QUICKBOOKS_PRODUCTION_INVENTORY_ADJUSTMENTS_REALM_ID=
QUICKBOOKS_PRODUCTION_REVIEWED_INVOICES_ENABLED=false
QUICKBOOKS_PRODUCTION_REVIEWED_INVOICES_REALM_ID=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:8080/api/quickbooks/callback
QUICKBOOKS_WEBHOOK_VERIFIER=
# A long random secret used to encrypt OAuth tokens at rest; do not rotate without reconnecting.
QUICKBOOKS_ENCRYPTION_KEY=

# Microsoft Outlook Calendar / Entra web app registration
# Organizations supports writable calendars accepted from shared mailboxes.
# For personal Microsoft accounts, use consumers and the personal-calendar scope.
OUTLOOK_TENANT_ID=organizations
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:8080/api/calendar/outlook/callback
# Generate a unique random value of at least 32 characters. Reconnect after rotating it.
OUTLOOK_ENCRYPTION_KEY=
